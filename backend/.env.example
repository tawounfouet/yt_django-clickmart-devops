DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database (DATABASE_URL via dj-database-url)
# Si vide → SQLite fallback automatique
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clickmart

# Media Storage Backend (local, s3, or cloudinary)
MEDIA_STORAGE_BACKEND=local
# S3-compatible (MinIO, AWS, OVH, Scaleway...)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=clickmart
# AWS_S3_ENDPOINT_URL=http://minio:9000
# Cloudinary (alternative)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Email Configuration
EMAIL_HOST_USER=example@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
